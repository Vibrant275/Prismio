let counter = 0

fn test_while() -> Int {
    let mut sum = 0
    let mut i = 1
    while (i <= 10) {
        sum = sum + i
        i = i + 1
    }
    return sum
}

fn test_if(val: Int) -> Int {
    if (val < 10) {
        return 1
    } else if (val == 10) {
        return 2
    } else {
        return 3
    }
}

fn main() {
    println("--- Test 2: Control Flow ---")
    
    let sum = test_while()
    print("While sum (1 to 10): ")
    println(sum)
    
    let a = test_if(5)
    let b = test_if(10)
    let c = test_if(15)
    
    print("If tests (1, 2, 3): ")
    print(a)
    print(b)
    println(c)
}
