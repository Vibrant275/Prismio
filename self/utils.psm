extern fn str_equals(s1: String, s2: String) -> Int
extern fn str_length(s: String) -> Int
extern fn str_concat(s1: String, s2: String) -> String
extern fn str_substring(s: String, start: Int, length: Int) -> String
extern fn str_char_at(s: String, index: Int) -> Char
extern fn str_contains(haystack: String, needle: String) -> Int
extern fn str_starts_with(s: String, prefix: String) -> Int
extern fn str_index_of(haystack: String, needle: String) -> Int
extern fn int_to_str(n: Int) -> String
extern fn str_to_int(s: String) -> Int

fn is_digit(c: Char) -> Bool {
    return c >= '0' and c <= '9'
}

fn is_alpha(c: Char) -> Bool {
    return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

fn is_alnum(c: Char) -> Bool {
    return is_alpha(c) or is_digit(c)
}

fn is_space(c: Char) -> Bool {
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'
}

fn is_separator(c: Char) -> Bool {
    if (c == '(') { return true }
    if (c == ')') { return true }
    if (c == '{') { return true }
    if (c == '}') { return true }
    if (c == '[') { return true }
    if (c == ']') { return true }
    if (c == ',') { return true }
    if (c == '.') { return true }
    if (c == ':') { return true }
    return false
}

fn is_operator(c: Char) -> Bool {
    if (c == '+') { return true }
    if (c == '-') { return true }
    if (c == '*') { return true }
    if (c == '/') { return true }
    if (c == '%') { return true }
    if (c == '<') { return true }
    if (c == '>') { return true }
    if (c == '!') { return true }
    if (c == '&') { return true }
    if (c == '|') { return true }
    if (c == '=') { return true }
    if (c == '_') { return true }
    return false
}
