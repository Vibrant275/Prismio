fn test_array_literal() {
    let numbers: [Int] = [1, 2, 3, 4, 5]

    let first = numbers[0]
    let third = numbers[2]

    println_int(first)
    println_int(third)
}

fn test_array_iteration() {
    let values: [Int] = [10, 20, 30, 40]

    let mut i = 0
    while (i < 4) {
        println_int(values[i])
        i = i + 1
    }
}

fn test_2d_array() {

    let matrix: [[Int]] = [[1, 2], [3, 4]]

    let value = matrix[0][1]
    println_int(value)
}

fn main() {
    test_array_literal()
    test_array_iteration()
    test_2d_array()
}