fn fibonacci(n: Int) -> Int {
    if (n <= 1) {
        return n
    } else {
        let a = fibonacci(n - 1)
        let b = fibonacci(n - 2)
        return a + b
    }
}

fn gcd(a: Int, b: Int) -> Int {
    if (b == 0) {
        return a
    } else {
        return gcd(b, a % b)
    }
}

fn main() {
    let fib10 = fibonacci(10)
    let gcd_val = gcd(48, 18)
    println("Test 6: Recursion")
    println("fibonacci(10) expected: 55, got:")
    println(fib10)
    println("gcd(48, 18) expected: 6, got:")
    println(gcd_val)
}