import prismio.io

let x = 5
let mut y = 1

fn add(a: Int, b: Int) -> Int {
    return a + b
}

fn main() {
    let result = add(x, y)

    if (result > 10) {
        println("Result is greater than 10")
    } else {
        println("Result is 10 or less")
    }

    let mut counter = 0
    while (counter < 5) {
        counter = counter + 1
    }
}