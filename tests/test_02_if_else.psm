fn max(a: Int, b: Int) -> Int {
    if (a > b) {
        return a
    } else {
        return b
    }
}

fn test_nested_if(x: Int) -> Int {
    if (x > 10) {
        if (x > 20) {
            return 2
        } else {
            return 1
        }
    } else {
        return 0
    }
}

fn main() {
    let result1 = max(5, 10)
    let result2 = test_nested_if(15)
    println("Test 2: If/Else")
    println("max(5,10) expected: 10, got:")
    println(result1)
    println("nested_if(15) expected: 1, got:")
    println(result2)
}