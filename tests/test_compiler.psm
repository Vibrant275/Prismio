// ============================================
// TOKEN TYPES
// ============================================

struct Token {
    type: Int,
    value: String,
    line: Int,
    column: Int
}

// Token type constants
let TOK_STRING = 0
let TOK_CHAR = 1
let TOK_NUMBER = 2
let TOK_BOOL = 3
let TOK_IDENTIFIER = 4
let TOK_SEPARATOR = 5
let TOK_OPERATOR = 6
let TOK_KEYWORD = 7
let TOK_EOF = 8

// ============================================
// LEXER
// ============================================

struct Lexer {
    input: String,
    position: Int,
    line: Int,
    column: Int
}

fn lexer_new(source: String) -> Lexer {
    let lex = Lexer {
        input: source,
        position: 0,
        line: 1,
        column: 0
    }
    return lex
}

fn lexer_current_char(lex: Lexer) -> Char {
    if (lex.position >= str_length(lex.input)) {
        return '\0'
    }
    return str_char_at(lex.input, lex.position)
}

fn lexer_advance(lex: Lexer) {
    lex.position = lex.position + 1
    lex.column = lex.column + 1
}

fn is_whitespace(c: Char) -> Int {
    if (c == ' ') { return 1 }
    if (c == '\t') { return 1 }
    if (c == '\n') { return 1 }
    if (c == '\r') { return 1 }
    return 0
}

fn is_digit(c: Char) -> Int {
    if (c >= '0') {
        if (c <= '9') {
            return 1
        }
    }
    return 0
}

fn is_alpha(c: Char) -> Int {
    if (c >= 'a') {
        if (c <= 'z') {
            return 1
        }
    }
    if (c >= 'A') {
        if (c <= 'Z') {
            return 1
        }
    }
    if (c == '_') { return 1 }
    return 0
}

fn is_alnum(c: Char) -> Int {
    if (is_alpha(c) == 1) { return 1 }
    if (is_digit(c) == 1) { return 1 }
    return 0
}

fn is_keyword(word: String) -> Int {
    if (str_equals(word, "fn") == 1) { return 1 }
    if (str_equals(word, "let") == 1) { return 1 }
    if (str_equals(word, "mut") == 1) { return 1 }
    if (str_equals(word, "if") == 1) { return 1 }
    if (str_equals(word, "else") == 1) { return 1 }
    if (str_equals(word, "while") == 1) { return 1 }
    if (str_equals(word, "for") == 1) { return 1 }
    if (str_equals(word, "return") == 1) { return 1 }
    if (str_equals(word, "struct") == 1) { return 1 }
    if (str_equals(word, "enum") == 1) { return 1 }
    if (str_equals(word, "true") == 1) { return 1 }
    if (str_equals(word, "false") == 1) { return 1 }
    if (str_equals(word, "extern") == 1) { return 1 }
    return 0
}

fn lexer_skip_whitespace(lex: Lexer) {
    while (lex.position < str_length(lex.input)) {
        let c = lexer_current_char(lex)

        if (is_whitespace(c) == 0) {
            break
        }

        if (c == '\n') {
            lex.line = lex.line + 1
            lex.column = 0
        }

        lexer_advance(lex)
    }
}

fn lexer_scan_number(lex: Lexer) -> Token {
    let start = lex.position
    let start_line = lex.line
    let start_col = lex.column

    while (lex.position < str_length(lex.input)) {
        let c = lexer_current_char(lex)

        if (is_digit(c) == 1) {
            lexer_advance(lex)
        } else {
            if (c == '_') {
                lexer_advance(lex)
            } else {
                break
            }
        }
    }

    let len = lex.position - start
    let value = str_substring(lex.input, start, len)

    let tok = Token {
        type: TOK_NUMBER,
        value: value,
        line: start_line,
        column: start_col
    }

    return tok
}

fn lexer_scan_identifier(lex: Lexer) -> Token {
    let start = lex.position
    let start_line = lex.line
    let start_col = lex.column

    while (lex.position < str_length(lex.input)) {
        let c = lexer_current_char(lex)

        if (is_alnum(c) == 1) {
            lexer_advance(lex)
        } else {
            break
        }
    }

    let len = lex.position - start
    let value = str_substring(lex.input, start, len)

    let tok_type = TOK_IDENTIFIER

    if (is_keyword(value) == 1) {
        tok_type = TOK_KEYWORD
    }

    let tok = Token {
        type: tok_type,
        value: value,
        line: start_line,
        column: start_col
    }

    return tok
}

fn lexer_scan_string(lex: Lexer) -> Token {
    let start_line = lex.line
    let start_col = lex.column

    lexer_advance(lex)  // skip opening quote
    let start = lex.position

    while (lex.position < str_length(lex.input)) {
        let c = lexer_current_char(lex)

        if (c == '"') {
            let len = lex.position - start
            let value = str_substring(lex.input, start, len)

            lexer_advance(lex)  // skip closing quote

            let tok = Token {
                type: TOK_STRING,
                value: value,
                line: start_line,
                column: start_col
            }

            return tok
        }

        lexer_advance(lex)
    }

    // Unclosed string
    let tok = Token {
        type: TOK_EOF,
        value: "",
        line: start_line,
        column: start_col
    }

    return tok
}

fn lexer_next_token(lex: Lexer) -> Token {
    lexer_skip_whitespace(lex)

    if (lex.position >= str_length(lex.input)) {
        let tok = Token {
            type: TOK_EOF,
            value: "",
            line: lex.line,
            column: lex.column
        }
        return tok
    }

    let c = lexer_current_char(lex)

    // Number
    if (is_digit(c) == 1) {
        return lexer_scan_number(lex)
    }

    // String
    if (c == '"') {
        return lexer_scan_string(lex)
    }

    // Identifier or keyword
    if (is_alpha(c) == 1) {
        return lexer_scan_identifier(lex)
    }

    // Single character tokens
    let start = lex.position
    lexer_advance(lex)

    let value = str_substring(lex.input, start, 1)

    let tok = Token {
        type: TOK_SEPARATOR,
        value: value,
        line: lex.line,
        column: lex.column
    }

    return tok
}

fn tokenize(source: String) -> [Token] {
    let lex = lexer_new(source)
    let tokens: [Token] = []

    while (1 == 1) {
        let tok = lexer_next_token(lex)

        // Add token to array (need array push)
        // tokens.push(tok)

        if (tok.type == TOK_EOF) {
            break
        }
    }

    return tokens
}

// ============================================
// AST NODES
// ============================================

struct ASTNode {
    node_type: Int,
    value: String,
    children: [ASTNode]
}

// Node type constants
let NODE_MODULE = 0
let NODE_FUNCTION = 1
let NODE_PARAM = 2
let NODE_VAR_DECL = 3
let NODE_IF = 4
let NODE_WHILE = 5
let NODE_RETURN = 6
let NODE_BLOCK = 7
let NODE_BINARY = 8
let NODE_LITERAL = 9
let NODE_IDENTIFIER = 10
let NODE_CALL = 11

fn node_new(node_type: Int, value: String) -> ASTNode {
    let node = ASTNode {
        node_type: node_type,
        value: value,
        children: []
    }
    return node
}

// ============================================
// PARSER
// ============================================

struct Parser {
    tokens: [Token],
    position: Int
}

fn parser_new(tokens: [Token]) -> Parser {
    let p = Parser {
        tokens: tokens,
        position: 0
    }
    return p
}

fn parser_current(p: Parser) -> Token {
    // return p.tokens[p.position]

    // Placeholder
    let tok = Token {
        type: TOK_EOF,
        value: "",
        line: 0,
        column: 0
    }
    return tok
}

fn parser_advance(p: Parser) {
    p.position = p.position + 1
}

fn parser_expect(p: Parser, expected: String) -> Int {
    let tok = parser_current(p)

    if (str_equals(tok.value, expected) == 1) {
        parser_advance(p)
        return 1
    }

    return 0
}

fn parse_expression(p: Parser) -> ASTNode {
    let tok = parser_current(p)

    if (tok.type == TOK_NUMBER) {
        parser_advance(p)
        return node_new(NODE_LITERAL, tok.value)
    }

    if (tok.type == TOK_IDENTIFIER) {
        parser_advance(p)
        return node_new(NODE_IDENTIFIER, tok.value)
    }

    return node_new(NODE_LITERAL, "0")
}

fn parse_statement(p: Parser) -> ASTNode {
    let tok = parser_current(p)

    if (str_equals(tok.value, "return") == 1) {
        parser_advance(p)
        let expr = parse_expression(p)
        return node_new(NODE_RETURN, "")
    }

    if (str_equals(tok.value, "let") == 1) {
        parser_advance(p)
        let name_tok = parser_current(p)
        parser_advance(p)
        return node_new(NODE_VAR_DECL, name_tok.value)
    }

    return parse_expression(p)
}

fn parse_block(p: Parser) -> ASTNode {
    parser_expect(p, "{")

    let block = node_new(NODE_BLOCK, "")

    while (1 == 1) {
        let tok = parser_current(p)

        if (str_equals(tok.value, "}") == 1) {
            parser_advance(p)
            break
        }

        let stmt = parse_statement(p)
        // block.children.push(stmt)
    }

    return block
}

fn parse_function(p: Parser) -> ASTNode {
    parser_expect(p, "fn")

    let name_tok = parser_current(p)
    parser_advance(p)

    parser_expect(p, "(")

    // Parse parameters
    while (1 == 1) {
        let tok = parser_current(p)

        if (str_equals(tok.value, ")") == 1) {
            parser_advance(p)
            break
        }

        parser_advance(p)
    }

    // Optional return type
    let tok = parser_current(p)
    if (str_equals(tok.value, "->") == 1) {
        parser_advance(p)
        parser_advance(p)  // skip type
    }

    // Body
    let body = parse_block(p)

    let func = node_new(NODE_FUNCTION, name_tok.value)
    // func.children.push(body)

    return func
}

fn parse_module(p: Parser) -> ASTNode {
    let module = node_new(NODE_MODULE, "")

    while (p.position < 100) {  // Would check array length
        let tok = parser_current(p)

        if (tok.type == TOK_EOF) {
            break
        }

        let decl = parse_function(p)
        // module.children.push(decl)
    }

    return module
}

// ============================================
// C CODE GENERATOR
// ============================================

fn codegen_emit_type(type_name: String) -> String {
    if (str_equals(type_name, "Int") == 1) {
        return "int"
    }
    if (str_equals(type_name, "Bool") == 1) {
        return "int"
    }
    if (str_equals(type_name, "Char") == 1) {
        return "char"
    }
    if (str_equals(type_name, "String") == 1) {
        return "char*"
    }
    return "void"
}

fn codegen_emit_function(node: ASTNode) -> String {
    let mut code = ""

    // Return type
    code = str_concat(code, "int ")

    // Function name
    code = str_concat(code, node.value)

    // Parameters
    code = str_concat(code, "() {\n")

    // Body
    code = str_concat(code, "    return 0;\n")

    code = str_concat(code, "}\n\n")

    return code
}

fn codegen_generate(ast: ASTNode) -> String {
    let mut code = ""

    // Includes
    code = str_concat(code, "#include <stdio.h>\n")
    code = str_concat(code, "#include <stdlib.h>\n\n")

    // Generate each function
    // for child in ast.children {
    //     code = str_concat(code, codegen_emit_function(child))
    // }

    return code
}

// ============================================
// FILE I/O
// ============================================

fn read_file(filename: String) -> String {
    let file = fopen(filename, "r")

    if (file == 0) {
        println("Error: Cannot open file")
        return ""
    }

    fseek(file, 0, 2)  // SEEK_END
    let size = ftell(file)
    fseek(file, 0, 0)  // SEEK_SET

    let buffer = malloc(size + 1)
    fread(buffer, 1, size, file)
    fclose(file)

    // Convert pointer to string (simplified)
    return ""
}

fn write_file(filename: String, content: String) -> Int {
    let file = fopen(filename, "w")

    if (file == 0) {
        return 1
    }

    let len = str_length(content)
    fwrite(0, 1, len, file)  // Would pass content pointer
    fclose(file)

    return 0
}

// ============================================
// MAIN COMPILER
// ============================================

fn compile(input_file: String, output_file: String) -> Int {
    println("=== Prismio Self-Hosting Compiler v2 ===")

    println("Reading source...")
    let source = read_file(input_file)

    println("Tokenizing...")
    let tokens = tokenize(source)
    println("Tokens generated")

    println("Parsing...")
    let parser = parser_new(tokens)
    let ast = parse_module(parser)
    println("AST constructed")

    println("Generating C code...")
    let c_code = codegen_generate(ast)
    println("Code generated")

    println("Writing output...")
    let result = write_file(output_file, c_code)

    if (result == 0) {
        println("=== Success! ===")
    }

    return result
}

fn main() -> Int {
    println("Prismio Self-Hosting Compiler v2")

    let result = compile("input.psm", "output.c")

    if (result == 0) {
        println("Compile output.c with: gcc output.c -o program")
    }

    return result
}