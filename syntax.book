1. Comments:

//      -> Code
///     -> Single line Info/ Documentation
/**/    -> Multi-Line Info/Documentation

2. Functions:

i.   fn add(a: Int, b: Int) -> Int = a + b

ii.  fn add(a: Int, b: Int) -> Int = (a + b)

iii. fn add(a: Int, b: Int) -> Int { // explicit return
       return a + b;                 // return is mandatory
     }

iv.  fn add(a: Int, b: Int) -> Int = {
       a+b                           // implicit return
     }                               // return is restricted

3. Access Modifiers:

private       ->      Same class/file
public        ->      Everywhere
internal      ->      Same module

4. Function overloading

fn add(a: Int, b: Int) -> Int = a + b
fn add(a: Int, b: Int, c: Int) -> Int = a + b + c
// Parameters must be different

5. Classes

     STRUCT
     IMPL
     ENUM
     TRAIT

6. Import

import lang.internal.files
import plugin.decoder

// Doesn't support wildcards

7. Relational operator

and, or  // This will be used
&& , ||  // This doesn't exists

8. Matcher

match x {
  "success" => "Login successful !"    // No comma
  "failed" =>  "Login failed !"
  _ => "Error"                         // Fallback (_ -> matcher wildcard)
}

9. Loops

for item in items {}                     -> Iterate

while (isActive or isOffline){}          -> While

loop {}                                  -> Infinite loop


